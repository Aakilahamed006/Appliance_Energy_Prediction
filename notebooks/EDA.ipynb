    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data = {\n",
    "    \"Hour\": [8, 9, 10, 11, 12],\n",
    "    \"Power\": [120, 125, 130, 128, 950]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "display(df)\n",
    "\n",
    "df[\"Power\"].plot(kind=\"line\")\n",
    "plt.show()"
   ]
